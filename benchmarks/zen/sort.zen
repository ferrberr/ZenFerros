// Benchmark: in-place heapsort over 500k u32 in a malloc'd buffer.
// Volatile access and the heap algorithm match c/, cpp/, rust/ byte for byte.
extern "C" {
    fn malloc(size: u64) -> u64;
    fn free(pointer: u64);
}

fn load(array: u64, index: u64) -> u32 {
    let mut value: u32 = 0u32;
    unsafe { value = volatile_load((array + index * 4u64) as *u32); }
    return value;
}
fn store(array: u64, index: u64, value: u32) {
    unsafe { volatile_store((array + index * 4u64) as *mut u32, value); }
}
fn sift(array: u64, start: u64, end: u64) {
    let mut root: u64 = start;
    while root * 2u64 + 1u64 <= end {
        let mut child: u64 = root * 2u64 + 1u64;
        if child + 1u64 <= end && load(array, child) < load(array, child + 1u64) {
            child += 1u64;
        }
        if load(array, root) < load(array, child) {
            let left: u32 = load(array, root);
            let right: u32 = load(array, child);
            store(array, root, right);
            store(array, child, left);
            root = child;
        } else {
            return;
        }
    }
}
fn main() -> i32 {
    let count: u64 = 500000u64;
    let bytes: u64 = count * 4u64;
    let mut array: u64 = 0u64;
    unsafe { array = malloc(bytes); }
    if array == 0u64 { return 2; }
    let mut state: u64 = 987654321u64;
    let mut i: u64 = 0u64;
    while i < count {
        state = state * 6364136223846793005u64 + 1442695040888963407u64;
        store(array, i, (state >> 33u64) as u32);
        i += 1u64;
    }
    if count > 1u64 {
        let mut start: u64 = count / 2u64;
        while start > 0u64 {
            start -= 1u64;
            sift(array, start, count - 1u64);
        }
        let mut end: u64 = count - 1u64;
        while end > 0u64 {
            let first: u32 = load(array, 0u64);
            let last: u32 = load(array, end);
            store(array, 0u64, last);
            store(array, end, first);
            end -= 1u64;
            sift(array, 0u64, end);
        }
    }
    let mut checksum: u64 = 0u64;
    i = 0u64;
    while i < count {
        checksum = checksum * 31u64 + (load(array, i) as u64);
        i += 1u64;
    }
    unsafe { free(array); }
    print_uint(checksum);
    print("\n");
    return 0;
}
