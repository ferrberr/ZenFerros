// Benchmark: 64-bit wrapping LCG arithmetic. Same algorithm as c/, cpp/, rust/.
// N iterations of multiply-add and a 32-bit fold; checksum printed once.
fn main() -> i32 {
    let mut state: u64 = 0x2545F4914F6CDD1Du64;
    let mut sum: u64 = 0u64;
    let mut i: u64 = 0u64;
    while i < 50000000u64 {
        state = state * 6364136223846793005u64 + 1442695040888963407u64;
        sum ^= state >> 32u64;
        i += 1u64;
    }
    print_uint(sum);
    print("\n");
    return 0;
}
