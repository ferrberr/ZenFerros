// Zen freestanding lexer: first self-hosted compiler component (TASK-902).
//
// It scans the same MVP source subset as zen/compiler/src/lexer/scanner.rs and
// only counts tokens; it does not build token values nor store spans. The
// public entry point writes 8 u64 counters to `out` (see docs/zen/selfhost.md).
//
// No libc, no structs, no arrays, no modules: raw addresses and volatile u8
// loads/stores, exactly like the Ferros kernel helpers.

fn read_u8(address:u64)->u64 {
    unsafe { return volatile_load(address as *u8) as u64; }
}

// 256 is an out-of-range sentinel so callers never read past `length`.
fn byte_at(source:u64,length:u64,pos:u64)->u64 {
    if pos>=length { return 256; }
    return read_u8(source+pos);
}

fn lit_eq(source:u64,total:u64,pos:u64,text:str)->bool {
    let n:u64=str_len(text);
    if pos+n>total { return false; }
    let mut i:u64=0;
    while i<n {
        if read_u8(source+pos+i)!=str_byte(text,i) as u64 { return false; }
        i+=1;
    }
    return true;
}

fn text_eq(source:u64,total:u64,pos:u64,len:u64,text:str)->bool {
    if str_len(text)!=len { return false; }
    return lit_eq(source,total,pos,text);
}

fn is_space(b:u64)->bool {
    if b==32 || b==9 || b==10 || b==13 { return true; }
    if b==11 || b==12 { return true; }
    return false;
}

fn is_digit(b:u64)->bool {
    if b>=48 && b<=57 { return true; }
    return false;
}

fn is_alpha(b:u64)->bool {
    if b>=97 && b<=122 { return true; }
    if b>=65 && b<=90 { return true; }
    return false;
}

fn is_alnum(b:u64)->bool {
    if is_digit(b) || is_alpha(b) { return true; }
    return false;
}

fn is_ident_char(b:u64)->bool {
    if is_alnum(b) || b==95 { return true; }
    return false;
}

fn is_hex(b:u64)->bool {
    if is_digit(b) { return true; }
    if b>=97 && b<=102 { return true; }
    if b>=65 && b<=70 { return true; }
    return false;
}

fn is_digit_base(b:u64,base:u64)->bool {
    if base==16 { return is_hex(b); }
    if base==8 { return b>=48 && b<=55; }
    if base==2 { return b==48 || b==49; }
    return is_digit(b);
}

// Mirrors the keyword table of zen/compiler/src/lexer/keywords.rs.
fn is_keyword(source:u64,total:u64,pos:u64,len:u64)->bool {
    if text_eq(source,total,pos,len,"fn") { return true; }
    if text_eq(source,total,pos,len,"let") { return true; }
    if text_eq(source,total,pos,len,"mut") { return true; }
    if text_eq(source,total,pos,len,"const") { return true; }
    if text_eq(source,total,pos,len,"if") { return true; }
    if text_eq(source,total,pos,len,"else") { return true; }
    if text_eq(source,total,pos,len,"while") { return true; }
    if text_eq(source,total,pos,len,"for") { return true; }
    if text_eq(source,total,pos,len,"return") { return true; }
    if text_eq(source,total,pos,len,"break") { return true; }
    if text_eq(source,total,pos,len,"continue") { return true; }
    if text_eq(source,total,pos,len,"struct") { return true; }
    if text_eq(source,total,pos,len,"impl") { return true; }
    if text_eq(source,total,pos,len,"mod") { return true; }
    if text_eq(source,total,pos,len,"use") { return true; }
    if text_eq(source,total,pos,len,"pub") { return true; }
    if text_eq(source,total,pos,len,"as") { return true; }
    if text_eq(source,total,pos,len,"type") { return true; }
    if text_eq(source,total,pos,len,"enum") { return true; }
    if text_eq(source,total,pos,len,"match") { return true; }
    if text_eq(source,total,pos,len,"loop") { return true; }
    if text_eq(source,total,pos,len,"unsafe") { return true; }
    if text_eq(source,total,pos,len,"extern") { return true; }
    if text_eq(source,total,pos,len,"sizeof") { return true; }
    if text_eq(source,total,pos,len,"alignof") { return true; }
    if text_eq(source,total,pos,len,"offsetof") { return true; }
    if text_eq(source,total,pos,len,"cast") { return true; }
    if text_eq(source,total,pos,len,"transmute") { return true; }
    if text_eq(source,total,pos,len,"true") { return true; }
    if text_eq(source,total,pos,len,"false") { return true; }
    if text_eq(source,total,pos,len,"void") { return true; }
    if text_eq(source,total,pos,len,"bool") { return true; }
    if text_eq(source,total,pos,len,"char") { return true; }
    if text_eq(source,total,pos,len,"i8") { return true; }
    if text_eq(source,total,pos,len,"i16") { return true; }
    if text_eq(source,total,pos,len,"i32") { return true; }
    if text_eq(source,total,pos,len,"i64") { return true; }
    if text_eq(source,total,pos,len,"i128") { return true; }
    if text_eq(source,total,pos,len,"isize") { return true; }
    if text_eq(source,total,pos,len,"u8") { return true; }
    if text_eq(source,total,pos,len,"u16") { return true; }
    if text_eq(source,total,pos,len,"u32") { return true; }
    if text_eq(source,total,pos,len,"u64") { return true; }
    if text_eq(source,total,pos,len,"u128") { return true; }
    if text_eq(source,total,pos,len,"usize") { return true; }
    if text_eq(source,total,pos,len,"f32") { return true; }
    if text_eq(source,total,pos,len,"f64") { return true; }
    if text_eq(source,total,pos,len,"never") { return true; }
    return false;
}

fn is_int_suffix(source:u64,total:u64,pos:u64,len:u64)->bool {
    if text_eq(source,total,pos,len,"i8") { return true; }
    if text_eq(source,total,pos,len,"i16") { return true; }
    if text_eq(source,total,pos,len,"i32") { return true; }
    if text_eq(source,total,pos,len,"i64") { return true; }
    if text_eq(source,total,pos,len,"i128") { return true; }
    if text_eq(source,total,pos,len,"isize") { return true; }
    if text_eq(source,total,pos,len,"u8") { return true; }
    if text_eq(source,total,pos,len,"u16") { return true; }
    if text_eq(source,total,pos,len,"u32") { return true; }
    if text_eq(source,total,pos,len,"u64") { return true; }
    if text_eq(source,total,pos,len,"u128") { return true; }
    if text_eq(source,total,pos,len,"usize") { return true; }
    return false;
}

// Length of the longest operator at `pos`, or 0 for an unexpected byte.
// Order matters: three-byte and two-byte prefixes first.
fn op_len(source:u64,total:u64,pos:u64)->u64 {
    if lit_eq(source,total,pos,"...") { return 3; }
    if lit_eq(source,total,pos,"<<=") { return 3; }
    if lit_eq(source,total,pos,">>=") { return 3; }
    if lit_eq(source,total,pos,"==") { return 2; }
    if lit_eq(source,total,pos,"!=") { return 2; }
    if lit_eq(source,total,pos,"<=") { return 2; }
    if lit_eq(source,total,pos,">=") { return 2; }
    if lit_eq(source,total,pos,"&&") { return 2; }
    if lit_eq(source,total,pos,"||") { return 2; }
    if lit_eq(source,total,pos,"+=") { return 2; }
    if lit_eq(source,total,pos,"-=") { return 2; }
    if lit_eq(source,total,pos,"**") { return 2; }
    if lit_eq(source,total,pos,"*=") { return 2; }
    if lit_eq(source,total,pos,"/=") { return 2; }
    if lit_eq(source,total,pos,"%=") { return 2; }
    if lit_eq(source,total,pos,"&=") { return 2; }
    if lit_eq(source,total,pos,"|=") { return 2; }
    if lit_eq(source,total,pos,"^=") { return 2; }
    if lit_eq(source,total,pos,"<<") { return 2; }
    if lit_eq(source,total,pos,">>") { return 2; }
    if lit_eq(source,total,pos,"..") { return 2; }
    if lit_eq(source,total,pos,"->") { return 2; }
    if lit_eq(source,total,pos,"=>") { return 2; }
    if lit_eq(source,total,pos,"::") { return 2; }
    let b:u64=read_u8(source+pos);
    if b==43 || b==45 || b==42 || b==47 || b==37 { return 1; }
    if b==60 || b==62 || b==33 || b==38 || b==124 || b==94 || b==126 { return 1; }
    if b==61 || b==46 || b==58 || b==59 || b==44 { return 1; }
    if b==40 || b==41 || b==91 || b==93 || b==123 || b==125 { return 1; }
    if b==63 || b==64 { return 1; }
    return 0;
}

// Returns the position just after a valid escape, or 0 if it is malformed.
// `pos` points at the backslash.
fn skip_escape(source:u64,length:u64,pos:u64)->u64 {
    let mut p:u64=pos+1;
    if p>=length { return 0; }
    let e:u64=read_u8(source+p);
    if e==110 || e==116 || e==114 || e==92 || e==34 || e==39 || e==48 { return p+1; }
    if e==120 {
        p+=1;
        let mut k:u64=0;
        while k<2 {
            if p>=length { return 0; }
            if !is_hex(read_u8(source+p)) { return 0; }
            p+=1;
            k+=1;
        }
        return p;
    }
    return 0;
}

pub fn zen_lex_report(source:u64,length:u64,out:u64) {
    let mut pos:u64=0;
    let mut tokens:u64=0;
    let mut idents:u64=0;
    let mut numbers:u64=0;
    let mut strings:u64=0;
    let mut keywords:u64=0;
    let mut punct:u64=0;
    let mut errors:u64=0;

    while pos<length {
        let b:u64=byte_at(source,length,pos);
        if is_space(b) {
            pos+=1;
            continue;
        }
        if b==47 && byte_at(source,length,pos+1)==47 {
            pos+=2;
            while pos<length && byte_at(source,length,pos)!=10 { pos+=1; }
            continue;
        }
        if b==47 && byte_at(source,length,pos+1)==42 {
            pos+=2;
            let mut depth:u64=1;
            while depth>0 && pos<length {
                let c:u64=byte_at(source,length,pos);
                if c==47 && byte_at(source,length,pos+1)==42 {
                    depth+=1;
                    pos+=2;
                } else if c==42 && byte_at(source,length,pos+1)==47 {
                    depth-=1;
                    pos+=2;
                } else {
                    pos+=1;
                }
            }
            if depth>0 {
                errors+=1;
                tokens+=1;
            }
            continue;
        }

        let start:u64=pos;
        if is_alpha(b) || b==95 {
            pos+=1;
            while pos<length && is_ident_char(byte_at(source,length,pos)) { pos+=1; }
            if is_keyword(source,length,start,pos-start) {
                keywords+=1;
            } else {
                idents+=1;
            }
            tokens+=1;
            continue;
        }

        if is_digit(b) {
            let mut base:u64=10;
            let mut invalid:bool=false;
            if b==48 {
                let n:u64=byte_at(source,length,pos+1);
                if n==120 || n==88 {
                    base=16;
                    pos+=2;
                } else if n==98 || n==66 {
                    base=2;
                    pos+=2;
                } else if n==111 || n==79 {
                    base=8;
                    pos+=2;
                }
            }
            if pos>=length {
                invalid=true;
            } else if !is_digit_base(byte_at(source,length,pos),base) {
                invalid=true;
            }
            while pos<length {
                let d:u64=byte_at(source,length,pos);
                if is_digit_base(d,base) {
                    pos+=1;
                } else if d==95 {
                    pos+=1;
                } else {
                    break;
                }
            }

            let mut is_float:bool=false;
            if base==10 && pos<length {
                if byte_at(source,length,pos)==46 && byte_at(source,length,pos+1)!=46 {
                    is_float=true;
                    pos+=1;
                    while pos<length {
                        let d:u64=byte_at(source,length,pos);
                        if is_digit(d) {
                            pos+=1;
                        } else if d==95 {
                            pos+=1;
                        } else {
                            break;
                        }
                    }
                }
            }
            let mut bad_exp:bool=false;
            if base==10 && pos<length {
                let e:u64=byte_at(source,length,pos);
                if e==101 || e==69 {
                    is_float=true;
                    pos+=1;
                    let s:u64=byte_at(source,length,pos);
                    if s==43 || s==45 { pos+=1; }
                    if pos>=length || !is_digit(byte_at(source,length,pos)) {
                        bad_exp=true;
                    } else {
                        while pos<length {
                            let d:u64=byte_at(source,length,pos);
                            if is_digit(d) {
                                pos+=1;
                            } else if d==95 {
                                pos+=1;
                            } else {
                                break;
                            }
                        }
                    }
                }
            }

            let suffix_start:u64=pos;
            if !bad_exp {
                while pos<length && is_ident_char(byte_at(source,length,pos)) { pos+=1; }
            }
            if invalid || bad_exp {
                errors+=1;
                tokens+=1;
                continue;
            }
            let suffix_len:u64=pos-suffix_start;
            let mut good:bool=false;
            if suffix_len==0 {
                good=true;
            } else if is_float {
                if text_eq(source,length,suffix_start,suffix_len,"f32") { good=true; }
                if text_eq(source,length,suffix_start,suffix_len,"f64") { good=true; }
            } else {
                if is_int_suffix(source,length,suffix_start,suffix_len) { good=true; }
            }
            if good {
                numbers+=1;
            } else {
                errors+=1;
            }
            tokens+=1;
            continue;
        }

        if b==34 {
            pos+=1;
            let mut closed:bool=false;
            let mut bad:bool=false;
            while pos<length {
                let c:u64=byte_at(source,length,pos);
                if c==34 {
                    pos+=1;
                    closed=true;
                    break;
                }
                if c==10 || c==13 {
                    bad=true;
                    break;
                }
                if c==92 {
                    let after:u64=skip_escape(source,length,pos);
                    if after==0 {
                        bad=true;
                        pos+=1;
                        if pos<length { pos+=1; }
                        break;
                    }
                    pos=after;
                } else {
                    pos+=1;
                }
            }
            if closed && !bad {
                strings+=1;
            } else {
                errors+=1;
            }
            tokens+=1;
            continue;
        }

        if b==39 {
            pos+=1;
            let mut bad:bool=false;
            if pos>=length {
                bad=true;
            } else {
                let c:u64=byte_at(source,length,pos);
                if c==39 || c==10 || c==13 {
                    bad=true;
                } else if c==92 {
                    let after:u64=skip_escape(source,length,pos);
                    if after==0 {
                        bad=true;
                        pos+=1;
                        if pos<length { pos+=1; }
                    } else {
                        pos=after;
                    }
                } else {
                    pos+=1;
                }
                if !bad {
                    if pos<length && byte_at(source,length,pos)==39 {
                        pos+=1;
                    } else {
                        bad=true;
                    }
                }
            }
            if bad {
                errors+=1;
            } else {
                strings+=1;
            }
            tokens+=1;
            continue;
        }

        let oplen:u64=op_len(source,length,pos);
        if oplen>0 {
            pos+=oplen;
            punct+=1;
        } else {
            pos+=1;
            errors+=1;
        }
        tokens+=1;
    }

    unsafe {
        volatile_store(out as *mut u64,tokens);
        volatile_store((out+8) as *mut u64,idents);
        volatile_store((out+16) as *mut u64,numbers);
        volatile_store((out+24) as *mut u64,strings);
        volatile_store((out+32) as *mut u64,keywords);
        volatile_store((out+40) as *mut u64,punct);
        volatile_store((out+48) as *mut u64,errors);
        volatile_store((out+56) as *mut u64,pos);
    }
}
