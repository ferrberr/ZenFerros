// Negative scheduler boot: healthy controller stack, real IDT/VMM.
pub fn kernel_entry(magic:u64,info:u64) {
    if !serial_init() { finish(0x11u32); return; }
    if magic!=0x2badb002u64 || info==0 { kernel_panic("invalid handoff"); return; }
    interrupts_init();
    if !pmm_init(info) || !vmm_init() || !scheduler_init() { kernel_panic("negative setup failed"); return; }
    serial_write("SCHEDULER STATE NEGATIVE\n");
    scheduler_set(8,1); thread_set(0,8,4); scheduler_set(16,99);
    scheduler_on_timer();
    kernel_panic("invalid scheduler state returned");
}
