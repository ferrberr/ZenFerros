// Hito7: single synchronous user task, a 2MiB virtual window and int0x80 ABI.
// State u64 slots: 0=initialized,8=active,16=exit,24=fault vector,32=error,
// 40=CR2,48=writes,56=rejected buffers,64=user IRQs,72=entry,80=loaded,
// 88=completed runs. No allocator or scheduler operation occurs inside a syscall.
fn user_get(offset:u64)->u64 {
    unsafe { return volatile_load((ferros_user_state()+offset) as *u64); }
}
fn user_set(offset:u64,value:u64) {
    unsafe { volatile_store((ferros_user_state()+offset) as *mut u64,value); }
}
fn user_read16(address:u64)->u64 {
    return (memory_read8(address) as u64) | ((memory_read8(address+1) as u64)<<8);
}
fn user_ph(image:u64,index:u64)->u64 {
    return image+memory_read64(image+32)+index*56;
}

// Validate every byte range before allocation. Strict static ELF64 profile:
// at most8 program headers, page-aligned nonoverlapping LOADs, no interpreter.
fn user_elf_validate(image:u64,length:u64)->bool {
    if image==0 || length<64 || length>131072 || image>18446744073709551615u64-length { return false; }
    if memory_read32(image)!=0x464c457fu64 || memory_read8(image+4)!=2u8 || memory_read8(image+5)!=1u8 || memory_read8(image+6)!=1u8 { return false; }
    if memory_read8(image+7)!=0u8 || user_read16(image+16)!=2 || user_read16(image+18)!=62 || memory_read32(image+20)!=1 { return false; }
    if memory_read32(image+48)!=0 || user_read16(image+52)!=64 || user_read16(image+54)!=56 { return false; }
    let count:u64=user_read16(image+56);
    let phoff:u64=memory_read64(image+32);
    if count==0 || count>8 || phoff<64 || phoff>length || count*56>length-phoff { return false; }
    let entry:u64=memory_read64(image+24);
    let mut entry_ok:bool=false;
    let mut loads:u64=0;
    let mut index:u64=0;
    while index<count {
        let ph:u64=user_ph(image,index);
        let kind:u64=memory_read32(ph);
        let flags:u64=memory_read32(ph+4);
        if kind==1 {
            let offset:u64=memory_read64(ph+8);
            let address:u64=memory_read64(ph+16);
            let filesz:u64=memory_read64(ph+32);
            let memsz:u64=memory_read64(ph+40);
            if (flags & ~7u64)!=0 || (flags & 4u64)==0 || (flags & 3u64)==3 { return false; }
            if address<0x40000000u64 || address>=0x40100000u64 || address%4096!=0 || memsz==0 || memsz>0x40100000u64-address { return false; }
            if memory_read64(ph+24)!=address || memory_read64(ph+48)!=4096 || offset%4096!=0 || offset>length || filesz>length-offset || filesz>memsz { return false; }
            let end:u64=(address+memsz+4095) & ~4095u64;
            let mut prior:u64=0;
            while prior<index {
                let old:u64=user_ph(image,prior);
                if memory_read32(old)==1 {
                    let start:u64=memory_read64(old+16);
                    let stop:u64=(start+memory_read64(old+40)+4095) & ~4095u64;
                    if address<stop && start<end { return false; }
                }
                prior+=1;
            }
            if (flags & 1u64)!=0 && entry>=address && entry-address<filesz { entry_ok=true; }
            loads+=1;
        } else if kind==0x6474e551u64 {
            if flags!=6 || memory_read64(ph+32)!=0 || memory_read64(ph+40)!=0 { return false; }
        } else if kind!=0 { return false; }
        index+=1;
    }
    return loads>0 && entry_ok;
}

fn user_pte(address:u64)->u64 {
    if address<0x40000000u64 || address>=0x40200000u64 { return 0; }
    unsafe { return memory_read64(ferros_user_tables()+4096+((address-0x40000000u64)/4096)*8); }
}
fn user_space_init()->bool {
    if memory_state_read(64)!=1 { return false; }
    unsafe {
        let tables:u64=ferros_user_tables();
        let root:u64=ferros_page_tables();
        if ferros_read_cr3()!=root || tables%4096!=0 || tables<ferros_rodata_end() || tables>ferros_kernel_end()-8192 { return false; }
        if user_get(0)!=0 || memory_read64(root+4096+8)!=0 { return false; }
        let parent:u64=memory_read64(root);
        if (parent & 0x000ffffffffff007u64)!=((root+4096)|3u64) { return false; }
        let mut offset:u64=0;
        while offset<8192 { memory_store64(tables+offset,0); offset+=8; }
        offset=0;
        while offset<4096 { user_set(offset,0); offset+=8; }
        memory_store64(tables,(tables+4096)|7u64);
        memory_store64(root+4096+8,tables|7u64);
        memory_store64(root,parent|4u64);
        ferros_load_cr3(root);
        if ferros_user_arch_init()!=1 { return false; }
        user_set(0,1);
        return true;
    }
}
fn user_map_page(address:u64,physical:u64,flags:u64)->bool {
    if user_get(0)!=1 || address<0x40000000u64 || address>=0x40200000u64 || address%4096!=0 || user_pte(address)!=0 { return false; }
    if physical==0 || physical%4096!=0 || physical>=0x4000000u64 { return false; }
    if flags!=5 && flags!=0x8000000000000005u64 && flags!=0x8000000000000007u64 { return false; }
    unsafe {
        memory_store64(ferros_user_tables()+4096+((address-0x40000000u64)/4096)*8,physical|flags);
        ferros_invlpg(address);
    }
    return true;
}
fn user_space_clear()->bool {
    if user_get(0)!=1 || user_get(8)!=0 { return false; }
    // A task never outlives its descriptors: close every VFS slot on teardown.
    vfs_close_all();
    let mut good:bool=true;
    let mut index:u64=0;
    unsafe {
        while index<512 {
            let slot:u64=ferros_user_tables()+4096+index*8;
            let entry:u64=memory_read64(slot);
            if entry!=0 {
                memory_store64(slot,0);
                ferros_invlpg(0x40000000u64+index*4096);
                if !pmm_free(entry & 0x000ffffffffff000u64) { good=false; }
            }
            index+=1;
        }
    }
    user_set(72,0); user_set(80,0);
    return good;
}
fn user_zero_page(address:u64) {
    let mut offset:u64=0;
    while offset<4096 { memory_store64(address+offset,0); offset+=8; }
}
fn user_load(image:u64,length:u64)->bool {
    if user_get(0)!=1 || user_get(8)!=0 || user_get(80)!=0 || !user_elf_validate(image,length) { return false; }
    let count:u64=user_read16(image+56);
    let mut index:u64=0;
    while index<count {
        let ph:u64=user_ph(image,index);
        if memory_read32(ph)==1 {
            let flags:u64=memory_read32(ph+4);
            let address:u64=memory_read64(ph+16);
            let filesz:u64=memory_read64(ph+32);
            let memsz:u64=memory_read64(ph+40);
            let mut page_flags:u64=0x8000000000000005;
            if (flags & 1u64)!=0 { page_flags=5; }
            else if (flags & 2u64)!=0 { page_flags=0x8000000000000007; }
            let mut page:u64=0;
            while page<memsz {
                let physical:u64=pmm_alloc();
                if physical==0 { user_space_clear(); return false; }
                user_zero_page(physical);
                let mut byte:u64=0;
                while byte<4096 && page+byte<filesz {
                    memory_write8(physical+byte,memory_read8(image+memory_read64(ph+8)+page+byte)); byte+=1;
                }
                if !user_map_page(address+page,physical,page_flags) {
                    pmm_free(physical); user_space_clear(); return false;
                }
                page+=4096;
            }
        }
        index+=1;
    }
    let mut stack:u64=0x401fc000;
    while stack<0x40200000u64 {
        let physical:u64=pmm_alloc();
        if physical==0 { user_space_clear(); return false; }
        user_zero_page(physical);
        if !user_map_page(stack,physical,0x8000000000000007u64) {
            pmm_free(physical); user_space_clear(); return false;
        }
        stack+=4096;
    }
    user_set(72,memory_read64(image+24)); user_set(80,1);
    return true;
}

// Validate the entire span before reading even the first byte. No wrap, kernel
// aliases, unmapped gaps or supervisor leaves are accepted. Single CPU/IF0.
fn user_buffer_valid(address:u64,length:u64)->bool {
    if address<0x40000000u64 || address>=0x40200000u64 || length>0x40200000u64-address { return false; }
    if length==0 { return true; }
    let end:u64=address+length;
    let mut page:u64=address & ~4095u64;
    while page<end {
        if (user_pte(page) & 5u64)!=5 { return false; }
        page+=4096;
    }
    return true;
}
// Kernel writes into this range: every covered page must be present, user and writable.
fn user_buffer_writable(address:u64,length:u64)->bool {
    if address<0x40000000u64 || address>=0x40200000u64 || length>0x40200000u64-address { return false; }
    if length==0 { return true; }
    let end:u64=address+length;
    let mut page:u64=address & ~4095u64;
    while page<end {
        if (user_pte(page) & 7u64)!=7 { return false; }
        page+=4096;
    }
    return true;
}
fn user_write(address:u64,length:u64)->u64 {
    if length>4096 { user_set(56,user_get(56)+1); return 18446744073709551594u64; }
    if !user_buffer_valid(address,length) { user_set(56,user_get(56)+1); return 18446744073709551602u64; }
    let mut offset:u64=0;
    while offset<length {
        if !serial_byte(memory_read8(address+offset)) { kernel_panic("user serial write failed"); return 18446744073709551611u64; }
        offset+=1;
    }
    user_set(48,user_get(48)+1);
    return length;
}

// VFS syscall implementations using RAMFS/VFS layer
fn user_open(path_ptr:u64,flags:u64)->i64 {
    if !user_buffer_valid(path_ptr,256) { return -14; } // EFAULT
    // Copy path from user space into the dedicated kernel scratch buffer.
    let mut kernel_path:u64 = 0;
    unsafe { kernel_path = ferros_user_scratch(); }
    let mut i:u64 = 0;
    while i < 255 {
        let c:u8 = memory_read8(path_ptr + i);
        memory_write8(kernel_path + i, c);
        if c == 0u8 { break; }
        i += 1;
    }
    memory_write8(kernel_path + i, 0u8);
    return vfs_open(kernel_path);
}
fn user_read(fd:u64,buf:u64,count:u64)->i64 {
    if count > 4096 { return -22; } // EINVAL
    if !user_buffer_writable(buf,count) { return -14; } // EFAULT: kernel must write there
    return vfs_read(fd, buf, count);
}
fn user_write_vfs(fd:u64,buf:u64,count:u64)->i64 {
    if count > 4096 { return -22; } // EINVAL
    if !user_buffer_valid(buf,count) { return -14; } // EFAULT: kernel reads from there
    return vfs_write_user(fd, buf, count);
}
fn user_close(fd:u64)->i64 {
    return vfs_close(fd);
}
// Syscall 9: enumerate the root directory as NUL separated names. The kernel
// writes into the user buffer, so it must be present, user and writable.
fn user_readdir(buf:u64,count:u64)->i64 {
    if count>4096 { return -22; } // EINVAL
    if !user_buffer_writable(buf,count) { return -14; } // EFAULT
    return vfs_readdir(buf,count);
}
// Syscall 8: non-blocking COM1 RX. 0xffffffff means "no byte is waiting".
fn user_read_char()->u64 {
    let value:i64=serial_try_read();
    if value<0 { return 0xffffffffu64; }
    return value as u64;
}

fn user_trap_origin(frame:u64)->bool {
    if user_get(8)!=1 { return false; }
    unsafe {
        if frame<ferros_user_kernel_stack_bottom()+136 || frame>ferros_user_kernel_stack_top()-40 { return false; }
    }
    return (memory_read64(frame+8) & 3u64)==3;
}

// Called only for a CPU frame originating in CPL3 on the private TSS stack.
// int0x80 numbers: 1=write,2=exit,3=irq_get,4=open,5=read,6=write_vfs,7=close,
// 8=read_char,9=readdir. Syscalls 1-8 keep their original contract.
fn user_interrupt_dispatch(vector:u64,error:u64,frame:u64,cr2:u64) {
    unsafe {
        let bottom:u64=ferros_user_kernel_stack_bottom();
        let top:u64=ferros_user_kernel_stack_top();
        if user_get(8)!=1 || frame<bottom+136 || frame>top-40 || (frame & 7u64)!=0 {
            kernel_panic("invalid user trap frame"); return;
        }
        if memory_read64(frame+8)!=0x23u64 || memory_read64(frame+32)!=0x1bu64 {
            kernel_panic("invalid user trap selectors"); return;
        }
        if vector==32 {
            user_set(64,user_get(64)+1); return;
        }
        if vector==128 && error==0 {
            let number:u64=memory_read64(frame-24);
            let a:u64=memory_read64(frame-64);
            let b:u64=memory_read64(frame-56);
            let c:u64=memory_read64(frame-48);
            let mut result:u64=18446744073709551578; // ENOSYS
            if number==1 { result=user_write(a,b); }
            else if number==2 {
                user_set(16,a); user_set(8,0); user_set(88,user_get(88)+1);
                ferros_user_leave(a); kernel_panic("user leave returned"); return;
            } else if number==3 { result=irq_get(16); }
            else if number==4 { result=user_open(a,b) as u64; }
            else if number==5 { result=user_read(a,b,c) as u64; }
            else if number==6 { result=user_write_vfs(a,b,c) as u64; }
            else if number==7 { result=user_close(a) as u64; }
            else if number==8 { result=user_read_char(); }
            else if number==9 { result=user_readdir(a,b) as u64; }
            memory_store64(frame-24,result);
            return;
        }
        // Only synchronous task faults are attributable to the user. NMI,
        // double fault, machine check and unexpected IRQs remain kernel-fatal.
        if vector!=0 && vector!=1 && vector!=3 && vector!=4 && vector!=5 && vector!=6 && vector!=11 && vector!=12 && vector!=13 && vector!=14 && vector!=17 {
            kernel_panic("unexpected system event in userspace"); return;
        }
        if vector==14 && ((error & 8u64)!=0 || (error & 4u64)==0) {
            kernel_panic("invalid user page table fault"); return;
        }
        // Terminate this task, never recover its RIP or bless its requested fault.
        user_set(24,vector); user_set(32,error); user_set(40,cr2);
        user_set(16,128+vector); user_set(8,0); user_set(88,user_get(88)+1);
        ferros_user_leave(128+vector); kernel_panic("user fault leave returned");
    }
}
fn user_run(case_id:u64)->u64 {
    if user_get(0)!=1 || user_get(8)!=0 || user_get(80)!=1 { return 255; }
    user_set(16,255); user_set(24,0); user_set(32,0); user_set(40,0);
    user_set(8,1);
    scheduler_timer_start();
    let mut result:u64=255;
    unsafe { result=ferros_user_enter(user_get(72),0x401ffff8u64,case_id); }
    scheduler_timer_stop();
    if user_get(8)!=0 || result!=user_get(16) { kernel_panic("invalid user return state"); return 255; }
    return result;
}
fn userspace_self_test()->bool {
    if !user_space_init() { return false; }
    unsafe {
        let image:u64=ferros_user_image_start();
        let length:u64=ferros_user_image_end()-image;
        let before:u64=pmm_free_count();
        if !user_load(image,length) { return false; }
        if user_pte(0x401fb000u64)!=0 || (memory_page_entry(0x100000u64) & 4u64)!=0 { return false; }
        // Writes are checked as a lower bound here: the runner asserts the exact
        // transcript-dependent count (18 with the default shell script, 9 without).
        if user_run(0)!=0 || user_get(24)!=0 || user_get(48)<5 || user_get(56)<6 || user_get(64)<1 { return false; }
        if !user_space_clear() || pmm_free_count()!=before { return false; }
        serial_write("USERSPACE: RING3 AND SYSCALLS OK\n");
        let mut case_id:u64=1;
        while case_id<=6 {
            if !user_load(image,length) { return false; }
            let result:u64=user_run(case_id);
            let mut expected:u64=142;
            let mut address:u64=0x100000;
            let mut error:u64=5;
            if case_id==2 { address=0x40000000; error=7; }
            else if case_id==3 || case_id==6 { expected=141; address=0; error=0; }
            else if case_id==4 { address=0x401ffff8; error=21; }
            else if case_id==5 { address=0x401fb000; error=4; }
            if case_id==6 { error=0x40a; }
            if result!=expected || user_get(24)!=expected-128 || user_get(32)!=error { return false; }
            if expected==142 && case_id!=4 && user_get(40)!=address { return false; }
            if expected==142 && case_id==4 && (user_get(40)<0x401fc000u64 || user_get(40)>=0x40200000u64) { return false; }
            if !user_space_clear() || pmm_free_count()!=before { return false; }
            case_id+=1;
        }
        if user_get(88)!=7 { return false; }
        serial_write("USERSPACE: ISOLATION AND CLEANUP OK\n");
        return true;
    }
}

