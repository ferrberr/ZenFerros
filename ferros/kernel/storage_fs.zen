fn pfs_unavailable() { serial_write("PFS: UNAVAILABLE\n"); }
fn pfs_boot() {
    let B:u64=heap_alloc(3584u64,16u64); if B==0u64 { pfs_unavailable(); return; }
    let bank:i64=pfs_mount(B); if bank<0i64 { pfs_unavailable(); return; }
    let table:u64=pfs_table(B,bank as u64); let boot_name:u64=pfs_boot_buf(B); pfs_zero(boot_name); pfs_write_magic(boot_name,"boot.txt",8u64);
    let found:i64=pfs_find_entry(table,boot_name); let mut counter:u64=1u64;
    if found>=0i64 { let e:u64=pfs_entry(table,found as u64); if ata_read_sector(memory_read32(e+32u64),pfs_data(B))<0i64 { pfs_unavailable(); return; } let old:u64=pfs_parse_boot(pfs_data(B),memory_read64(e+24u64)); if old>0u64 && old<18446744073709551615u64 { counter=old+1u64; } }
    let payload:u64=pfs_aux(B); pfs_zero(payload); pfs_write_magic(payload,"boot=",5u64); let digits:u64=pfs_digits(payload+5u64,counter); memory_write8(payload+5u64+digits,10u8);
    if pfs_commit_internal(boot_name,payload,6u64+digits,0u64,B,true)<0i64 { pfs_unavailable(); return; }
    let current:i64=pfs_select(B); if current<0i64 { pfs_unavailable(); return; }
    serial_write("PFS: BOOT "); serial_uint(counter); serial_write(" FILES="); serial_uint(memory_read32(pfs_root(B,current as u64)+12u64)); serial_write("\n");
}
