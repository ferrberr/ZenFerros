// ZENFS02: two checksummed COW roots. LBA16..32 are a read-only ZENFS01
// migration source. Root A/B=33/34, table A/B=35/36, data=37..45, marker=46.
// Scratch B needs 3584 bytes: roots, tables, data, aux, boot text.
fn pfs_zero(p:u64) { let mut i:u64=0; while i<512u64 { memory_write8(p+i,0u8); i+=1u64; } }
fn pfs_copy(dst:u64,src:u64,n:u64) { let mut i:u64=0; while i<n { memory_write8(dst+i,memory_read8(src+i)); i+=1u64; } }
fn pfs_put32(p:u64,v:u64) { let mut i:u64=0; while i<4u64 { memory_write8(p+i,((v>>(i*8u64))&255u64) as u8); i+=1u64; } }
fn pfs_put64(p:u64,v:u64) { let mut i:u64=0; while i<8u64 { memory_write8(p+i,((v>>(i*8u64))&255u64) as u8); i+=1u64; } }
fn pfs_hash_step(h:u64,b:u8)->u64 { return ((h^(b as u64))*16777619u64)&4294967295u64; }
fn pfs_hash(p:u64,n:u64)->u64 { let mut h:u64=2166136261u64; let mut i:u64=0; while i<n { h=pfs_hash_step(h,memory_read8(p+i)); i+=1u64; } return h; }
fn pfs_all_zero(p:u64,n:u64)->bool { let mut i:u64=0; while i<n { if memory_read8(p+i)!=0u8 { return false; } i+=1u64; } return true; }
fn pfs_magic(p:u64,s:str,n:u64)->bool { let mut i:u64=0; while i<n { if memory_read8(p+i)!=str_byte(s,i) { return false; } i+=1u64; } return true; }
fn pfs_write_magic(p:u64,s:str,n:u64) { let mut i:u64=0; while i<n { memory_write8(p+i,str_byte(s,i)); i+=1u64; } }
fn pfs_ptr_len(p:u64)->u64 { let mut i:u64=0; while i<24u64 { if memory_read8(p+i)==0u8 { return i; } i+=1u64; } return 24u64; }
fn pfs_ptr_ok(p:u64)->bool { if p==0u64 { return false; } let n:u64=pfs_ptr_len(p); if n==0u64 || n>23u64 { return false; } let mut i:u64=0; while i<n { let b:u8=memory_read8(p+i); if b<32u8 || b>126u8 || b==47u8 { return false; } i+=1u64; } return true; }
