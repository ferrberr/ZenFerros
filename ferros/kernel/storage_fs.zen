fn pfs_marker_write(B:u64)->i64 { let m:u64=pfs_aux(B); pfs_zero(m); pfs_write_magic(m,"ZENACT02",8u64); pfs_put32(m+8u64,2u64); pfs_put32(m+12u64,pfs_hash(m,12u64)); if ata_write_sector(46u64,m)<0i64 || ata_flush()<0i64 { return -2i64; } return 0i64; }
fn pfs_root_make(B:u64,bank:u64,generation:u64,count:u64)->i64 {
